{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Athena",
  "version": "0.1.0",
  "identifier": "dev.athena.desktop",
  "build": {
    "frontendDist": "../loading",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Athena",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
